<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template — scripts/install-launchd.sh fills the __PLACEHOLDERS__ and writes
  ~/Library/LaunchAgents/com.deck.server.plist. The program is node (boot.mjs, outside ~/Documents) so that
  Full Disk Access for node covers the whole tree; boot.mjs runs the relaunch loop, which restarts the server
  (no KeepAlive: the loop never gives up, and a refused second loop must not be respawned). AbandonProcessGroup:
  stopping the job ends the loop, not the server. Environment (DECK_EXTRA_HOSTS, …) comes from ~/.config/deck/env,
  read by run.sh at every start (launchd has no env-file support).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.deck.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__HOME__/.config/deck/boot.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/.config/deck</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>ExitTimeOut</key>
  <integer>__EXIT_TIMEOUT__</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.config/deck/deck.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.config/deck/deck.log</string>
</dict>
</plist>
