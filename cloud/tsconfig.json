{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "src",
    "test",
    "../src/shared/cloud/b64.ts",
    "../src/shared/cloud/api-types.ts",
    "../src/shared/cloud/envelope.ts"
  ]
}
